#version 450

// Writes a flat colour into a storage image, so a test can dispatch it and then sample the
// result through the ordinary graphics path.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform Push {
   vec4 color;
} push;

void main() {
   const ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
   if (any(greaterThanEqual(coord, imageSize(outImage)))) return;
   imageStore(outImage, coord, push.color);
}
